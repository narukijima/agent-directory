# External writes stay interactive in the public template. A deployed Agent may
# replace a prompt rule with a narrowly reviewed allow rule for its normal path.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Repository writes require an Agent-specific reviewed rule",
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "GitHub API operations require an Agent-specific reviewed rule",
)

prefix_rule(
    pattern = [["npm", "pnpm"], "publish"],
    decision = "prompt",
    justification = "Package publication requires an Agent-specific reviewed rule",
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "Repository deletion is outside the unattended normal path",
)
