{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [],
    "ask": [
      "Bash(git push *)",
      "Bash(gh api *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)"
    ],
    "deny": [
      "Bash(gh repo delete *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [],
      "deniedDomains": []
    }
  }
}
